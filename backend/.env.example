# backend/.env.example — commit this file (no real secrets here)
# Copy to .env and fill in the values before running the server.

NODE_ENV=development
PORT=3000

# Database (matches docker-compose.yml defaults for local dev)
DATABASE_URL=postgresql://fraudshield:dev_password_change_in_prod@localhost:5432/fraudshield_dev

# Redis (matches docker-compose.yml defaults for local dev)
REDIS_URL=redis://localhost:6379

# JWT secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password hashing cost (12 is safe; use 4 in tests to keep them fast)
BCRYPT_ROUNDS=12

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Arkesel SMS API (leave blank in dev — OTPs are printed to console instead)
ARKESEL_API_KEY=
